FROM cokoapps/base:24 as server

RUN corepack enable
WORKDIR /home/node/hhmi

COPY .yarnrc.yml .
COPY package.json .
COPY yarn.lock .

RUN chown -R node:node .
USER node

RUN yarn workspaces focus --production && yarn cache clean && rm -rf ~/.npm

COPY --chown=node:node . .

RUN yarn coko-server build

